# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already excluded in .gitignore.

# n8n uses this to encrypt stored credentials in its internal database.
# Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_hex_32

# API key for the LLM used to score each news item (Phase 2).
# Use whichever provider's key matches the model you configure in n8n's credentials.
LLM_API_KEY=changeme_llm_api_key

# Telegram bot token, from @BotFather after you create a bot (see README setup steps).
TELEGRAM_BOT_TOKEN=changeme_telegram_bot_token

# NOTE: the Telegram chat ID (where the digest and error alerts get sent) is NOT
# a secret, so it lives in config/config.json instead of here — see "telegram.chat_id".
