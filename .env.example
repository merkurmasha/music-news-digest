# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already excluded in .gitignore.

# n8n uses this to encrypt stored credentials in its internal database.
# Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_hex_32

# Anthropic API key, used by the "Score Candidates (Claude)" node to call
# https://api.anthropic.com/v1/messages. Read inside the workflow via the
# n8n expression $env.LLM_API_KEY — docker-compose's env_file passes it
# through to the container automatically.
LLM_API_KEY=changeme_llm_api_key

# Telegram bot token, from @BotFather (see README setup steps). Read inside
# the workflow via $env.TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=changeme_telegram_bot_token

# NOTE: the Telegram chat ID (where the digest and error alerts get sent) is NOT
# a secret, so it lives in config/config.json instead of here — see "telegram.chat_id".
