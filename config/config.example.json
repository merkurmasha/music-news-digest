{
  "sources": [
    {
      "id": "music-ally",
      "name": "Music Ally",
      "type": "rss",
      "url": "https://musically.com/feed/",
      "language": "en",
      "enabled": true,
      "max_items": 20
    },
    {
      "id": "hypebot",
      "name": "Hypebot",
      "type": "rss",
      "url": "https://www.hypebot.com/feed",
      "language": "en",
      "enabled": true,
      "max_items": 20
    },
    {
      "id": "water-and-music",
      "name": "Water & Music",
      "type": "rss",
      "url": "https://www.waterandmusic.com/feed",
      "language": "en",
      "enabled": true,
      "max_items": 20
    },
    {
      "id": "example-telegram-channel",
      "name": "Example Telegram Channel",
      "type": "telegram",
      "channel": "example_channel",
      "language": "en",
      "enabled": false,
      "max_items": 20
    },
    {
      "id": "example-email-inbox",
      "name": "Example Newsletter Inbox",
      "type": "email",
      "mailbox": {
        "host": "imap.example.com",
        "port": 993,
        "username": "you@example.com",
        "folder": "INBOX"
      },
      "language": "en",
      "enabled": false,
      "max_items": 10
    }
  ],
  "llm": {
    "provider": "anthropic",
    "model": "claude-haiku-5-5",
    "cost_per_mtok_input": 0.10,
    "cost_per_mtok_output": 0.50
  },
  "rubric": {
    "instructions": "Score this headline and snippet from 0 (irrelevant) to 10 (must-read) for a music-tech industry professional who tracks: AI tools for music creation/distribution/rights, streaming platform economics and policy, major-label and artist business deals, and emerging music tech startups. Penalize celebrity gossip, tour/show announcements with no business angle, and minor rehashes of stories already widely covered."
  },
  "threshold": 6,
  "telegram": {
    "chat_id": "YOUR_TELEGRAM_CHAT_ID"
  },
  "digest": {
    "intro_template": "Music industry news from {from} to {to}: {count} items from {sources} sources."
  },
  "run": {
    "lookback_hours_on_first_run": 24
  },
  "eval": {
    "export_candidates_csv": false,
    "backfill_days": 30
  }
}
